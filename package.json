{
  "name": "gazprom-arena-diorama",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/*.test.mjs",
    "test:seating": "node --test tests/vehicle-seats.test.mjs tests/golf-physical-exit.test.mjs tests/vehicle-interaction.test.mjs",
    "test:seating:browser": "node tools/vite-functional.mjs --seating",
    "serve:legacy": "node tools/serve.mjs",
    "baseline": "node tools/baseline.mjs",
    "baseline:verify": "node tools/baseline.mjs --verify",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:core": "node --test tests/core-primitives.test.mjs tests/terrain.test.mjs tests/stadium.test.mjs tests/zsd.test.mjs tests/surroundings.test.mjs tests/batching.test.mjs tests/parking.test.mjs tests/drift.test.mjs tests/traffic.test.mjs tests/golf-drive.test.mjs tests/hud.test.mjs",
    "vite:shots": "node tools/vite-baseline.mjs",
    "vite:approve": "node tools/vite-baseline.mjs --approve",
    "vite:verify": "node tools/vite-baseline.mjs --verify",
    "perf:compare": "npm run build && node tools/perf-compare.mjs",
    "test:browser": "node tools/vite-functional.mjs && node tools/multiplayer-browser.mjs",
    "test:pedestrian": "node --test tests/pedestrian.test.mjs",
    "test:pedestrian:browser": "node tools/vite-functional.mjs --pedestrian",
    "multiplayer:server": "node server/multiplayer.mjs",
    "test:multiplayer": "node --test tests/network-*.test.mjs",
    "test:multiplayer:browser": "node tools/multiplayer-browser.mjs",
    "check:quick": "npm run test:multiplayer",
    "check:network": "npm run test:multiplayer && npm run test:multiplayer:browser",
    "check:release": "npm run build && npm run test:unit && npm run test:browser",
    "test:picker": "node --test tests/vehicle-picker.test.mjs"
  },
  "devDependencies": {
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.0",
    "pngjs": "^7.0.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "three": "^0.164.1",
    "ws": "^8.22.0"
  }
}
